#version 450
// =============================================================================
// Trium-XBT Portable Vulkan Compute Shader: Dual-Rail Balanced Ternary MatVec
// =============================================================================
// Target: SPIR-V across NVIDIA, AMD RDNA, Intel Arc, Qualcomm Adreno,
//         ARM Mali, and Apple MoltenVK.
//
// Evaluates y_out[m] = row_scales[m] * x_scale * <W[m, :], x>
// using column-major bit-sliced dual-rail storage W_P[m + M * k], W_N[m + M * k]
// and portable SPIR-V OpBitCount via bitCount(uvec2(unpackUint2x32(...))).
// =============================================================================
#extension GL_ARB_gpu_shader_int64 : enable

layout(constant_id = 0) const uint WORKGROUP_SIZE = 64u;
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(local_size_x_id = 1) in;

layout(set = 0, binding = 0) readonly buffer BufW_P { uint64_t W_P[]; };
layout(set = 0, binding = 1) readonly buffer BufW_N { uint64_t W_N[]; };
layout(set = 0, binding = 2) readonly buffer BufX_P { uint64_t x_P[]; };
layout(set = 0, binding = 3) readonly buffer BufX_N { uint64_t x_N[]; };
layout(set = 0, binding = 4) readonly buffer BufRowScales { float row_scales[]; };
layout(set = 0, binding = 5) writeonly buffer BufYOut { float y_out[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K_words;
    float x_scale;
    uint has_row_scales;
} pc;

void main() {
    if (WORKGROUP_SIZE == 0u) return;

    uint m = gl_GlobalInvocationID.x;
    if (m >= pc.M) return;

    int64_t acc = int64_t(0);
    for (uint k = 0u; k < pc.K_words; ++k) {
        uint idx = m + pc.M * k;
        uint64_t wp = W_P[idx];
        uint64_t wn = W_N[idx];
        uint64_t xp = x_P[k];
        uint64_t xn = x_N[k];

        uint64_t p_prod = (wp & xp) | (wn & xn);
        uint64_t n_prod = (wp & xn) | (wn & xp);

        // Portable SPIR-V OpBitCount matching gemm_shader.comp
        uvec2 pc_bits = bitCount(uvec2(unpackUint2x32(p_prod)));
        uvec2 nc_bits = bitCount(uvec2(unpackUint2x32(n_prod)));
        acc += int64_t(pc_bits.x + pc_bits.y) - int64_t(nc_bits.x + nc_bits.y);
    }

    float r_scale = (pc.has_row_scales != 0u) ? row_scales[m] : 1.0;
    y_out[m] = r_scale * pc.x_scale * float(acc);
}
