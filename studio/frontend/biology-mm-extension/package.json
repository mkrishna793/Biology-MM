{
  "name": "@molstar/biology-mm-extension",
  "version": "1.0.0",
  "type": "module",
  "description": "Mol* v6 GPU-accelerated extension for Biology-MM live streaming, physics colormaps, and volumetric fields",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/plugin-ui": "workspace:*",
    "@molstar/mvs": "workspace:*"
  },
  "devDependencies": {
    "@molstar/test-harness": "workspace:*",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  }
}
